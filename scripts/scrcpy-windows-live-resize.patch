+#ifdef HAVE_D3D11VA
+static bool
+sc_interop_software_upload_d3d11(struct sc_interop_software *sw,
+                                const AVFrame *frame) {
+    // SDL's normal D3D11 YUV upload allocates a staging texture for every
+    // plane on every frame. Update the existing shader resources in place.
+    const char *renderer_name = SDL_GetRendererName(sw->renderer);
+    int chroma_width = (frame->width + 1) / 2;
+    if (!renderer_name || strcmp(renderer_name, "direct3d11")
+            || !frame->data[0] || !frame->data[1] || !frame->data[2]
+            || frame->linesize[0] < frame->width
+            || frame->linesize[1] < chroma_width
+            || frame->linesize[2] < chroma_width
+            || !SDL_FlushRenderer(sw->renderer)) {
+        return false;
+    }
+
+    SDL_PropertiesID renderer_props = SDL_GetRendererProperties(sw->renderer);
+    ID3D11Device *device = SDL_GetPointerProperty(renderer_props,
+                               SDL_PROP_RENDERER_D3D11_DEVICE_POINTER, NULL);
+    if (!device) {
+        return false;
+    }
+
+    SDL_PropertiesID props = SDL_GetTextureProperties(sw->interop.texture);
+    ID3D11Resource *planes[] = {
+        SDL_GetPointerProperty(props, SDL_PROP_TEXTURE_D3D11_TEXTURE_POINTER, NULL),
+        SDL_GetPointerProperty(props, SDL_PROP_TEXTURE_D3D11_TEXTURE_U_POINTER, NULL),
+        SDL_GetPointerProperty(props, SDL_PROP_TEXTURE_D3D11_TEXTURE_V_POINTER, NULL),
+    };
+    if (!planes[0] || !planes[1] || !planes[2]) {
+        return false;
+    }
+
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Device_GetImmediateContext(device, &context);
+    if (!context) {
+        return false;
+    }
+    for (unsigned i = 0; i < 3; ++i) {
+        ID3D11DeviceContext_UpdateSubresource(context, planes[i], 0, NULL,
+                                              frame->data[i],
+                                              (UINT) frame->linesize[i], 0);
+    }
+    ID3D11DeviceContext_Release(context);
+    return SUCCEEDED(ID3D11Device_GetDeviceRemovedReason(device));
+}
+#endif
