<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Morror — подключение по QR-коду" Width="820" Height="640" MinWidth="760" MinHeight="580" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#10191F" Foreground="#EFF5F3" FontFamily="Segoe UI" FontSize="16" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#385448" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="20,0,8,0"><TextBlock Text="◈   morror / Wi-Fi" Foreground="#A9C6B6" VerticalAlignment="Center"/><Button x:Name="QrTitleClose" Style="{DynamicResource CaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" AutomationProperties.Name="Закрыть QR-код"/></Grid>
    <ScrollViewer Grid.Row="1" Margin="28,12,28,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="Подключение по QR-коду" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Android 11+ · одна сеть с ПК · сканер беспроводной отладки" Foreground="#94A5AE" Margin="0,8,0,22"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="White" CornerRadius="12" Width="260" Height="260"><Grid><Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR-код для сопряжения Android"/><TextBlock x:Name="QrFinished" Text="✓" FontSize="72" Foreground="#285E40" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="НА ТЕЛЕФОНЕ" FontSize="14" FontWeight="SemiBold" Foreground="#80AA98" Margin="0,0,0,12"/>
          <TextBlock Text="1. Откройте настройки" FontWeight="SemiBold" FontSize="19"/><TextBlock Text="Для разработчиков → Беспроводная отладка." Foreground="#94A5AE" LineHeight="25" Margin="0,6,0,17"/>
          <TextBlock Text="2. Выберите QR-сканер" FontWeight="SemiBold" FontSize="19"/><TextBlock Text="«Подключить устройство с помощью QR-кода»." Foreground="#94A5AE" LineHeight="25" Margin="0,6,0,17"/>
          <TextBlock Text="3. Дождитесь подключения" FontWeight="SemiBold" FontSize="19"/><TextBlock Text="Наведите сканер на код и оставьте окно открытым." Foreground="#94A5AE" LineHeight="25" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </StackPanel></ScrollViewer>
      <Border Grid.Row="2" Background="#1B2C29" CornerRadius="10" Padding="13,11" Margin="28,17,28,0"><TextBlock x:Name="QrStatus" Text="Подготовка QR-кода…" Foreground="#BAF3CF" FontSize="16"/></Border>
      <Grid Grid.Row="3" Margin="28,16,28,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="QrCountdown" Foreground="#829BA3" FontSize="15" VerticalAlignment="Center"/><Button x:Name="QrRenew" Grid.Column="1" Content="Новый QR-код" Margin="10,0,8,0"/><Button x:Name="QrClose" Grid.Column="2" Content="Отмена"/></Grid>
  </Grid></Border>
</Window>


