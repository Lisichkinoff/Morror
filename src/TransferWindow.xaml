<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Morror — фото и буфер" Width="1100" Height="820" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#22232D" Foreground="#F4F3FA" FontFamily="Segoe UI" FontSize="15" UseLayoutRounding="True" AllowDrop="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E6E4F2"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3"/><Setter Property="Width" Value="150"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" CornerRadius="9" BorderBrush="#383A49" BorderThickness="1" Background="#30313F" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#A99AFF"/><Setter TargetName="Item" Property="Background" Value="#443957"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#A590D5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="#22232D"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Background="#23242E"><TextBlock Text="◈  morror / Обмен" Foreground="#C6B5E8" VerticalAlignment="Center" Margin="24,0"/><Button x:Name="TransferClose" Style="{DynamicResource CaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Margin="0,0,8,0" AutomationProperties.Name="Закрыть обмен файлами"/></Grid>
    <Grid Grid.Row="1" Margin="24,18,24,18"><StackPanel><TextBlock Text="Фото и буфер обмена" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="TransferDevice" Foreground="#B7A9CB" Margin="0,5,0,0"/></StackPanel><TextBlock Text="Перетащите файл, чтобы отправить на телефон" FontSize="13" Foreground="#9891AC" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="260"/></Grid>
    <Grid Grid.Row="2" Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="254"/></Grid.ColumnDefinitions>
      <Border Background="#2B2D3A" BorderBrush="#383A49" BorderThickness="1" CornerRadius="13" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ComboBox x:Name="RemoteFolder" SelectedIndex="0" AutomationProperties.Name="Папка на телефоне"><ComboBoxItem Content="Камера" Tag="/sdcard/DCIM/Camera"/><ComboBoxItem Content="Фотографии" Tag="/sdcard/Pictures"/><ComboBoxItem Content="Загрузки" Tag="/sdcard/Download"/><ComboBoxItem Content="Фото Morror" Tag="/sdcard/Pictures/Morror"/><ComboBoxItem Content="Память телефона" Tag="/sdcard"/></ComboBox>
        <Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="RemoteUp" Content="↑" Padding="12,6" ToolTip="На папку выше"/><TextBlock x:Name="RemotePath" Grid.Column="1" Foreground="#AAA3BB" FontSize="12" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="RemoteRefresh" Grid.Column="2" Content="↻" Padding="12,6" ToolTip="Обновить файлы"/></Grid>
        <ListBox x:Name="RemoteFiles" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Галерея файлов телефона">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><StackPanel>
            <Grid Height="96" Background="#252631"><TextBlock Text="{Binding Icon}" FontSize="32" Foreground="#A590D5" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/></Grid>
            <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding PreviewHint}" FontSize="10" Foreground="#AAA3BB" Height="16" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,8"><Button x:Name="PreviousPage" Content="←" Padding="10,5" HorizontalAlignment="Left" AutomationProperties.Name="Предыдущая страница"/><TextBlock x:Name="PageLabel" FontSize="12" Foreground="#AAA3BB" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button x:Name="NextPage" Content="→" Padding="10,5" HorizontalAlignment="Right" AutomationProperties.Name="Следующая страница"/></Grid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ReceiveClipboard" Content="Копировать в буфер ПК" Background="#A99AFF" BorderBrush="#A99AFF" Foreground="#272139" Padding="10,12"/><Button x:Name="ReceiveSave" Grid.Column="1" Content="Сохранить…" Margin="8,0,0,0" Padding="10,12"/></Grid>
      </Grid></Border>
      <Border Grid.Column="2" Background="#2B2D3A" BorderBrush="#383A49" BorderThickness="1" CornerRadius="13" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Background="#252631" CornerRadius="8" Height="145"><Image x:Name="SelectedPreview" Stretch="Uniform"/></Border>
        <TextBlock x:Name="SelectedName" Text="Выберите фото" FontSize="13" Foreground="#B7A9CB" Margin="0,8,0,16" TextWrapping="Wrap"/>
        <TextBlock Text="На телефон" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Button x:Name="SendFile" Content="Выбрать файл…" Padding="8,11" Margin="0,0,0,8"/>
        <Button x:Name="SendClipboardImage" Content="Изображение из буфера" Padding="8,11" Margin="0,0,0,8"/>
        <Button x:Name="OpenSentFile" Content="Открыть на телефоне" Padding="8,11" IsEnabled="False"/>
        <Border Height="1" Background="#383A49" Margin="0,18"/>
        <Button x:Name="ReceiveScreen" Content="Снимок экрана в буфер" Padding="8,11"/>
        <Expander Header="Как работает обмен" Foreground="#B7A9CB" Margin="0,14,0,0"><TextBlock Text="Выберите фото → скопируйте в буфер → Ctrl+V на ПК. Превью загружаются по 12 элементов; большие файлы и неподдерживаемые форматы доступны без превью. На телефон файлы сохраняются в Pictures/Morror или Download/Morror. Общий Ctrl+C / Ctrl+V в трансляции передаёт текст." FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/></Expander>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="3" Background="#363044" CornerRadius="10" Padding="14" Margin="24,14,24,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TransferResultTitle" Text="Подключение" FontWeight="SemiBold" Foreground="#A99AFF" Margin="0,0,0,4"/><TextBlock x:Name="TransferStatus" Text="Открываем файлы телефона…" Foreground="#CFC3E1" FontSize="13" TextWrapping="Wrap"/></StackPanel><Button x:Name="OpenReceivedFolder" Grid.Column="1" Content="Загрузки на ПК" FontSize="13" Padding="10,8" VerticalAlignment="Top" Margin="12,0,0,0"/></Grid></Border>
  </Grid>
</Window>
