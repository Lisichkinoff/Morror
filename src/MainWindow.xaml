<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Morror — экран Android на ПК" Width="980" Height="840" MinWidth="760" MinHeight="650"
        Background="#0D1318" Foreground="#EFF5F3" FontFamily="Segoe UI" FontSize="16"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#94A5AE"/>
    <SolidColorBrush x:Key="Accent" Color="#BAF3CF"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#233039"/><Setter Property="Foreground" Value="#E5EEE9"/>
      <Setter Property="Padding" Value="16,12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#34444B"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.5"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.35"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#BAF3CF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#9DADB3"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10191F"/><Setter Property="Foreground" Value="#EFF5F3"/>
      <Setter Property="CaretBrush" Value="#BAF3CF"/><Setter Property="BorderBrush" Value="#33434A"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
        </Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#BAF3CF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#10191F"/><Setter Property="Foreground" Value="#EFF5F3"/><Setter Property="CaretBrush" Value="#BAF3CF"/>
      <Setter Property="BorderBrush" Value="#33434A"/><Setter Property="Padding" Value="12,11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#BAF3CF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E4EFEB"/><Setter Property="Padding" Value="11,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#293D3E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2A413B"/><Setter Property="Foreground" Value="#C3F5D6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#10191F"/><Setter Property="Foreground" Value="#E4EFEB"/><Setter Property="BorderBrush" Value="#33434A"/>
      <Setter Property="MinHeight" Value="44"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Selector" Background="#10191F" BorderBrush="#33434A" BorderThickness="1" CornerRadius="9"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#A6B9B7" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selector" Property="BorderBrush" Value="#7BAA97"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Selector" Property="BorderBrush" Value="#BAF3CF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="13,10,35,10" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
          <TextBlock x:Name="Empty" Text="Подключите телефон…" Foreground="#7F939D" Margin="13,10,35,10" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#19242B" BorderBrush="#3B514A" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,5,0,5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="280" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="Empty" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E1EBE7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Border x:Name="Track" Grid.Column="1" Width="44" Height="26" CornerRadius="13" Background="#38464D"><Ellipse x:Name="Knob" Width="20" Height="20" Fill="#D1DCD8" HorizontalAlignment="Left" Margin="3"/></Border>
        </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#BAF3CF"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="#163329"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#161F26"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="23"/><Setter Property="BorderBrush" Value="#2A363E"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#9DAEB6"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  </Window.Resources>
  <Grid Background="#0D1318">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#10171D" BorderBrush="#243039" BorderThickness="0,0,0,1">
      <Grid Margin="24,0,6,0"><TextBlock Text="◈  morror" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="Свернуть"/><Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="Развернуть"/><Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" AutomationProperties.Name="Закрыть"/></StackPanel>
      </Grid>
    </Border>
    <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24" MaxWidth="940">
        <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Ваш Android на ПК" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Подключите телефон и начните трансляцию." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="StatusBadge" Text="●  Ожидание" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ProfileGap" Width="18"/><ColumnDefinition x:Name="ProfileColumn" Width="220"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="20"><StackPanel>
              <Grid Margin="0,0,0,14"><TextBlock Text="Подключение" FontSize="19" FontWeight="SemiBold"/><Button x:Name="RefreshButton" Content="↻" HorizontalAlignment="Right" Padding="9,4" ToolTip="Обновить устройства" AutomationProperties.Name="Обновить устройства"/></Grid>
              <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="UsbButton" Content="USB" Background="#BAF3CF" BorderBrush="#BAF3CF" Foreground="#163329"/><Button x:Name="WifiButton" Grid.Column="2" Content="Wi-Fi"/></Grid>
              <TextBlock x:Name="ConnectionHint" Text="Подключите кабель и разрешите отладку на телефоне." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,12"/>
              <StackPanel x:Name="WifiPanel" Visibility="Collapsed" Margin="0,0,0,14">
                <Button x:Name="QrButton" Content="Подключить по QR-коду" Margin="0,0,0,8"/>
                <Button x:Name="UsbWifiButton" Content="Перейти с USB на Wi-Fi" ToolTip="Телефон и ПК в одной сети. Сначала подключите USB и разрешите отладку. Включает ADB TCP/IP на порту 5555 до перезагрузки телефона; используйте доверенную сеть."/>
                <Expander x:Name="ManualWifi" Header="Код или IP-адрес" Foreground="#A9C3B8" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0">
                  <TextBlock Text="Беспроводная отладка → Сопряжение по коду" Style="{StaticResource Label}" FontSize="14"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="PairAddress" AutomationProperties.Name="IP и порт сопряжения" ToolTip="IP:порт из окна с кодом"/><PasswordBox x:Name="PairCode" Grid.Column="1" MaxLength="6" Margin="8,0,0,0" AutomationProperties.Name="Код сопряжения" ToolTip="6 цифр с телефона"/></Grid>
                  <Button x:Name="PairButton" Content="Сопряжение и подключение" Margin="0,8,0,14"/>
                  <TextBlock Text="Уже сопряжён? IP:порт с главной страницы отладки" Style="{StaticResource Label}" FontSize="14"/>
                  <TextBox x:Name="ConnectAddress" AutomationProperties.Name="IP и порт подключения"/>
                  <Button x:Name="ConnectButton" Content="Подключить по адресу" Margin="0,8,0,0"/>
                </StackPanel></Expander>
              </StackPanel>
              <ComboBox x:Name="Devices" DisplayMemberPath="Label" AutomationProperties.Name="Телефон"/>
              <TextBlock x:Name="DeviceHint" Text="Ищем устройства…" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/>
              <Button x:Name="TransferButton" Content="Фото и буфер обмена" Margin="0,14,0,0" IsEnabled="False"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0"><StackPanel>
              <TextBlock Text="Трансляция" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <ComboBox x:Name="StreamPreset" SelectedIndex="0" AutomationProperties.Name="Режим трансляции"><ComboBoxItem Content="Баланс · HD / 60 FPS"/><ComboBoxItem Content="Меньше нагрев · 720 px / 30 FPS"/><ComboBoxItem Content="Чётко · Full HD / 60 FPS"/><ComboBoxItem Content="Свои настройки"/></ComboBox>
              <CheckBox x:Name="Audio" Content="Звук на ПК" IsChecked="True" Margin="0,16,0,0"/>
              <Expander Header="Настройки" Foreground="#A9C3B8" Margin="0,16,0,0"><StackPanel Margin="0,14,0,0">
                <TextBlock Text="Разрешение" Style="{StaticResource Label}"/>
                <ComboBox x:Name="Quality" SelectedIndex="1" AutomationProperties.Name="Разрешение трансляции"><ComboBoxItem Content="720 px · 4 Мбит/с"/><ComboBoxItem Content="HD · 1280 px / 8 Мбит/с"/><ComboBoxItem Content="Full HD · 1920 px / 16 Мбит/с"/><ComboBoxItem Content="2K · 2048 px / 20 Мбит/с"/><ComboBoxItem Content="QHD · 2560 px / 24 Мбит/с"/><ComboBoxItem Content="4K · 3840 px / 40 Мбит/с"/><ComboBoxItem Content="Исходное · 32 Мбит/с"/></ComboBox>
                <TextBlock Text="Частота кадров" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                <ComboBox x:Name="FrameRate" SelectedIndex="2" AutomationProperties.Name="Частота кадров"><ComboBoxItem Content="Без ограничения" Tag="0"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/><ComboBoxItem Content="90 FPS" Tag="90"/><ComboBoxItem Content="120 FPS" Tag="120"/><ComboBoxItem Content="144 FPS" Tag="144"/><ComboBoxItem Content="165 FPS" Tag="165"/><ComboBoxItem Content="180 FPS" Tag="180"/><ComboBoxItem Content="240 FPS" Tag="240"/></ComboBox>
                <TextBlock x:Name="FpsHint" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,14"/>
                <CheckBox x:Name="ScreenOff" Content="Гасить экран телефона при старте" IsChecked="False" ToolTip="Уменьшает расход экрана. Alt+Shift+O включает его обратно." Margin="0,0,0,14"/>
                <CheckBox x:Name="Control" Content="Мышь и клавиатура" IsChecked="True" Margin="0,0,0,14"/>
                <ComboBox x:Name="KeyboardMode" SelectedIndex="0" AutomationProperties.Name="Режим клавиатуры"><ComboBoxItem Content="Физическая клавиатура · все языки"/><ComboBoxItem Content="Совместимость · SDK"/></ComboBox>
                <Button x:Name="KeyboardSettings" Content="Языки клавиатуры на телефоне" Margin="0,8,0,0"/>
                <TextBlock Text="Во время трансляции добавьте русский и английский в раскладки физической клавиатуры Android. Обычно язык переключается Ctrl+Пробел. Alt+K открывает настройки." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,14"/>
                <CheckBox x:Name="ClipboardSync" Content="Общий текстовый буфер" IsChecked="True" Margin="0,0,0,14"/>
                <CheckBox x:Name="AlwaysOnTop" Content="Поверх остальных окон" IsChecked="False" Margin="0,0,0,14"/>
                <CheckBox x:Name="AutoTray" Content="Скрывать Morror в трей при старте" IsChecked="True"/>
              </StackPanel></Expander>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="ProfilePanel" Grid.Column="2"><Border Style="{StaticResource Card}" Padding="18" Background="#1B2C29" BorderBrush="#385448"><StackPanel>
            <TextBlock Text="УСТРОЙСТВО" FontSize="12" Foreground="#9CC7AC"/>
            <TextBlock x:Name="DeviceModel" Text="Телефон не выбран" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <TextBlock x:Name="DeviceDetails" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,20"/>
            <TextBlock x:Name="DeviceResolution" Text="—" Margin="0,0,0,8"/>
            <TextBlock x:Name="DeviceRefresh" Text="—" Margin="0,0,0,8"/>
            <TextBlock x:Name="DeviceAndroid" Text="—" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
            <TextBlock x:Name="ProfileFps" Text="60 FPS" Foreground="{StaticResource Accent}" Margin="0,0,0,16"/>
            <Button x:Name="DevicePresetButton" Content="Исходное качество" Padding="10,12" IsEnabled="False"/>
          </StackPanel></Border></StackPanel>
        </Grid>
        <Expander Header="Журнал подключения" Foreground="#8AA69F" Margin="0,16,0,0"><TextBox x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0"/></Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#111A20" BorderBrush="#243039" BorderThickness="0,1,0,0" Padding="28,16"><StackPanel>
      <TextBlock x:Name="Notice" Visibility="Collapsed" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="Начать трансляцию" Background="#BAF3CF" BorderBrush="#BAF3CF" Foreground="#153126" FontWeight="SemiBold" IsEnabled="False"/><Button x:Name="StopButton" Grid.Column="1" Content="Стоп" Margin="10,0,0,0" IsEnabled="False"/></Grid>
      <TextBlock x:Name="SessionHint" Text="Экран откроется в отдельном окне · Alt+F — полный экран" FontSize="12" Foreground="#829BA3" Margin="0,8,0,0"/>
    </StackPanel></Border>
  </Grid>
</Window>
